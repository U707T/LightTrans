<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="轻译 · 选中即译"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="在任何 App 里选中文本 → 点菜单里的「AI 翻译」→ 译文以悬浮卡片显示。无需悬浮窗 / 无障碍等任何权限。"
            android:textColor="@color/text_sub"
            android:textSize="13sp" />

        <!-- ==================== 翻译设置 ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_section"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/SectionTitle"
                android:text="翻译设置" />

            <TextView
                style="@style/FieldLabel"
                android:text="目标语言" />

            <Spinner
                android:id="@+id/spLang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <CheckBox
                android:id="@+id/cbStream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/primary"
                android:text="流式输出（打字机效果，服务不支持时自动回退）"
                android:textColor="@color/text_main"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ==================== AI 引擎 ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_section"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="AI 引擎" />

                <Button
                    android:id="@+id/btnAddEngine"
                    style="@style/Btn.Small"
                    android:text="添加引擎" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="选中文本时用哪个引擎；点「编辑」可以给每个引擎单独设置翻译风格、思考模式，勾「参与对比」可同时看多家结果。"
                android:textColor="@color/text_hint"
                android:textSize="11sp" />

            <CheckBox
                android:id="@+id/cbMulti"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="@color/primary"
                android:text="多引擎对比（同时请求多个引擎）"
                android:textColor="@color/text_main"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/boxEngines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ==================== 测试 ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_section"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/SectionTitle"
                android:text="测试翻译" />

            <EditText
                android:id="@+id/edTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="输入一段文字试试，结果会流式显示"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:padding="10dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnTest"
                style="@style/Btn.Small"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:text="测试" />

            <TextView
                android:id="@+id/tvTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_main"
                android:textIsSelectable="true"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ==================== 帮助 ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_section"
            android:orientation="vertical"
            android:padding="14dp">

            <Button
                android:id="@+id/btnSelfCheck"
                style="@style/Btn.Small"
                android:layout_gravity="end"
                android:text="自检：菜单支持情况" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:text="· 权限：只有 INTERNET(普通权限，安装即授予，不弹窗) —— 悬浮窗/通知/无障碍全都不需要。\n· 三种入口：① 选中文字 → 点菜单里的「轻译」；② 选中 → 分享 →「轻译」；③ 浏览器的翻译图标（ACTION_TRANSLATE 通道）。\n· 原理：文本框的菜单项 = android.intent.action.PROCESS_TEXT；本应用以半透明对话框 Activity 的形式叠加在当前界面之上，看起来像悬浮窗，却不需要任何权限。\n· 菜单里看不到「轻译」时：点多选菜单右侧的 ⋮ 或「更多」，部分系统会把它收进二级菜单；网页里请走「分享」。\n· API Key 只保存在本机 SharedPreferences，请求直达你配置的引擎。\n· 翻译风格与思考模式都是每个引擎各自的设置（「编辑」里改）；悬浮卡片上也能随手切换。" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
