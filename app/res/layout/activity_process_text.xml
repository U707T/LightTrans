<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- 标题栏：标题 + 引擎 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI 翻译"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spEngine"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_circle"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:stateListAnimator="@null"
                    android:text="×"
                    android:textColor="@color/text_sub"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 第二行：风格 + 思考模式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnThink"
                    style="@style/Btn.Small"
                    android:layout_marginStart="8dp"
                    android:text="思考：自动" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSrc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_soft"
                android:ellipsize="end"
                android:maxLines="3"
                android:padding="10dp"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:background="@color/divider" />

            <TextView
                android:id="@+id/tvThink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:ellipsize="end"
                android:maxLines="6"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDst"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:minHeight="44dp"
                android:textColor="@color/text_main"
                android:textIsSelectable="true"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_hint"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/boxResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- 底部按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRetry"
                    style="@style/Btn.Small"
                    android:background="@drawable/btn_primary"
                    android:textColor="#FFFFFF"
                    android:text="重新翻译" />

                <Button
                    android:id="@+id/btnReplace"
                    style="@style/Btn.Small"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_plain"
                    android:textColor="@color/text_sub"
                    android:text="替换原文" />

                <Button
                    android:id="@+id/btnCopy"
                    style="@style/Btn.Small"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_plain"
                    android:textColor="@color/text_sub"
                    android:text="复制" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</ScrollView>
