<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LightTrans.Main" parent="@android:style/Theme.DeviceDefault.Light">
        <item name="android:windowBackground">@color/bg_page</item>
        <!-- 配色是写死的浅色：别让系统“强制深色”把它反转 -->
        <item name="android:forceDarkAllowed">false</item>
        <!-- Android 15+ 强制 edge-to-edge，statusBarColor 会被忽略，靠 light 标志决定图标黑白。
             不声明的话目标是「白图标压在 #F5F7FB 上」= 看不见。 -->
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bg_page</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- 悬浮卡片主题：透明、无标题、不遮暗背景、点外部关闭。
         必须是 .Light：之前继承的是深色的 Theme.DeviceDefault.Dialog，
         深色模式下 Spinner 弹出面板是黑的，而下拉文字是写死的近黑 #15181E —— 整个下拉一片黑。 -->
    <style name="Theme.LightTrans.Float" parent="@android:style/Theme.DeviceDefault.Light.Dialog">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <!-- 卡片宽度：这两行不能删。
             只靠代码里的 setLayout() 不够——它在 setContentView() 之前调用，
             会被 PhoneWindow.generateLayout() 重置回 WRAP_CONTENT，卡片会缩成一条细长条。 -->
        <item name="android:windowMinWidthMajor">94%</item>
        <item name="android:windowMinWidthMinor">94%</item>
    </style>

    <!-- ===== 小部件通用样式 ===== -->

    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Btn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Btn.Small">
        <item name="android:textSize">12sp</item>
        <!-- 原来只有 ~24dp 高，手指点不准；40dp 是不改观感前提下能做到的最大值 -->
        <item name="android:minHeight">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <style name="Btn.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Btn.Plain">
        <item name="android:background">@drawable/btn_plain</item>
        <item name="android:textColor">@color/text_sub</item>
    </style>
</resources>
